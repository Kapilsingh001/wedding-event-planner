# Address of the database API (JSON Server)
VITE_API_URL=http://localhost:3001

# The name used in invitation links while the website runs on localhost.
# It must be a real domain name that points to 127.0.0.1, or WhatsApp will not
# make the link clickable. The default is kalyanam.localtest.me
# VITE_LOCAL_SHARE_HOST=kalyanam.localtest.me

# Public address of the website, for the WhatsApp link preview picture.
# Not needed on a laptop. On Vercel it is filled in automatically.
# VITE_SITE_URL=https://your-site.vercel.app
